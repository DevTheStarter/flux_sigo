# Fluxo · variáveis de ambiente (spec §20). Copiar para .env.local. Nunca comitar valores reais.

# Supabase (projeto na região EU)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só rotas /api/admin e /api/cron. Nunca chega ao navegador.
SUPABASE_SERVICE_ROLE_KEY=

# AES-256-GCM para config_entidade.fonte_credencial: 64 caracteres hex.
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CHAVE_CIFRA=

# Resend (região EU). Sem valor, os emails são só registados no log.
RESEND_API_KEY=

# Vercel Cron envia Authorization: Bearer <CRON_SECRET> em GET. Sem valor, os crons recusam tudo.
CRON_SECRET=

# Remetente dos emails (convites, avisos, relatório). O domínio tem de estar verificado no Resend.
EMAIL_DE="Fluxo <fluxo@thestarter.io>"

# Destino dos problemas reportados (§11)
EMAIL_REPORTES=people@thestarter.io

# URL pública da aplicação, usada nos links dos emails (convites, recuperação). Sem barra final.
NEXT_PUBLIC_SITE_URL=

# Só para o teste de isolamento (test/rls.integration.test.ts), contra um projeto de teste
# FLUXO_TEST_SUPABASE_URL=
# FLUXO_TEST_ANON_KEY=
# FLUXO_TEST_SERVICE_ROLE_KEY=
